{
    "name": "graystackit/laravel-dymo-printer",
    "description": "A Laravel package for DYMO LabelWriter integration with Alpine.js and Livewire support",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "dymo", "dymo-connect", "printer", "label", "printing", "livewire", "alpine"],
    "authors": [
        {
            "name": "Graystack",
            "email": "dev@graystack.cloud"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "livewire/livewire": "Required for the Livewire printer-select component (^3.0|^4.0)"
    },
    "require-dev": {
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "GraystackIT\\DymoPrinter\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "GraystackIT\\DymoPrinter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GraystackIT\\DymoPrinter\\DymoPrinterServiceProvider"
            ],
            "aliases": {
                "DymoPrinter": "GraystackIT\\DymoPrinter\\Facades\\DymoPrinter"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
